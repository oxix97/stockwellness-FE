# ─────────────────────────────────────────────────────────────────────────────
# 이 파일을 복사해 tests/.auth.env 를 만든 뒤 실제 값을 채워주세요.
# tests/.auth.env 는 .gitignore 에 의해 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────────────────────
#
# [토큰 얻는 방법]
# 1. 앱(http://localhost:5173)에 카카오 또는 구글로 로그인
# 2. 브라우저 개발자 도구 → Application → Local Storage 열기
# 3. refreshToken 값을 TEST_REFRESH_TOKEN 에 붙여넣기
# 4. auth-storage → state 에서 memberId, email, nickname, portfolioId 확인
# ─────────────────────────────────────────────────────────────────────────────

# 앱 localStorage → accessToken  (유효 시간: 약 1시간, 유효하면 재발급 생략)
TEST_ACCESS_TOKEN=

# 앱 localStorage → refreshToken  (accessToken 만료 시 자동 재발급에 사용)
TEST_REFRESH_TOKEN=

# 로그인 계정 정보 (auth-storage → state 에서 확인)
TEST_MEMBER_ID=1
TEST_EMAIL=
TEST_NICKNAME=테스터
TEST_PORTFOLIO_ID=1

# 테스트 대상 백엔드 URL (기본값: http://localhost:8080)
TEST_BACKEND_URL=http://localhost:8080
